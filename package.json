{
  "name": "gocanopy-test",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky && pnpm install:pre-commit",
    "install:pre-commit": "chmod +x .husky/pre-commit",
    "format": "prettier . --write",
    "infra:start": "docker compose up -d",
    "infra:stop": "docker compose down",
    "db:migrate": "pnpm --filter @gocanopy/models db:migrate",
    "db:fresh": "pnpm infra:start && pnpm db:migrate",
    "serve": "pnpm --filter @gocanopy/server serve",
    "web:dev": "pnpm --filter @gocanopy/web dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.14.0",
  "devDependencies": {
    "@types/node": "25.9.1",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "eslint": "10.4.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.5",
    "prettier": "3.8.3",
    "pretty-quick": "4.2.2",
    "turbo": "2.9.14",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  }
}
